# ---------------------------------------------------------------------------
# cohi-api (control plane) — environment
# Copy to .env and adjust. Secrets MUST be changed before any real deployment.
# ---------------------------------------------------------------------------

APP_NAME=cohi-api
APP_ENV=development
LOG_LEVEL=info
LOG_FORMAT=text

# HTTP
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Railway / cloud platforms inject PORT; it overrides HTTP_PORT when set.
# PORT=8080

# Comma-separated CIDRs trusted for X-Forwarded-For. Empty = do not trust proxies.
TRUSTED_PROXIES=

# CORS. Use * only for local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://cohi:cohi@localhost:5432/cohi?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h
AUTO_MIGRATE=true
MIGRATIONS_PATH=./migrations

# JWT — generate with: openssl rand -base64 48
# In production these are required (min 32 characters).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=cohi-api

# Shared secret between cohi-api and recording-worker (internal routes).
# Required in production. Development defaults to local-dev-internal-token.
INTERNAL_SERVICE_TOKEN=local-dev-internal-token

# MediaMTX
MEDIAMTX_ENABLED=true
# Internal URL used by cohi-api to call the Control API.
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=
MEDIAMTX_TIMEOUT=8s
# Public URLs returned to clients (browser / VLC), not docker-internal hostnames.
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_URL=http://localhost:8889
# Internal Playback API used by cohi-api to stream recordings (never expose to browsers).
MEDIAMTX_PLAYBACK_URL=http://localhost:9996

# recording-worker
# COHI_API_URL=http://localhost:8080
# WORKER_POLL_INTERVAL=15s
# HTTP_PORT=8081

# ---------------------------------------------------------------------------
# Railway production (paste into the service Variables raw editor)
# Postgres must be PostgreSQL — MySQL is not supported.
# ---------------------------------------------------------------------------
# APP_ENV=production
# AUTO_MIGRATE=true
# LOG_LEVEL=info
# LOG_FORMAT=json
# CORS_ALLOWED_ORIGINS=*
# MEDIAMTX_ENABLED=false
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# JWT_ACCESS_SECRET=<openssl rand -base64 48>
# JWT_REFRESH_SECRET=<openssl rand -base64 48>
# INTERNAL_SERVICE_TOKEN=<openssl rand -base64 32>
