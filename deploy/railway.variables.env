# cohi-api — paste into Railway → cohi-api → Variables → Raw Editor
# Postgres service in this project is named "Postgres".

APP_ENV=production
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=*
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_TOKEN=
MEDIAMTX_ENABLED=false
# After you add the mediamtx service, switch the next lines on:
# MEDIAMTX_ENABLED=true
# MEDIAMTX_API_URL=http://mediamtx.railway.internal:9997
# MEDIAMTX_PLAYBACK_URL=http://mediamtx.railway.internal:9996
# MEDIAMTX_RTSP_URL=rtsp://mediamtx.railway.internal:8554
# MEDIAMTX_HLS_URL=http://mediamtx.railway.internal:8888
# MEDIAMTX_WEBRTC_URL=http://mediamtx.railway.internal:8889
