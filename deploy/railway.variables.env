# Paste into Railway → cohi-api service → Variables → Raw Editor.
# Requires a PostgreSQL plugin/service named "Postgres" in the same project.
# Generate the three secrets locally: openssl rand -base64 48

APP_ENV=production
AUTO_MIGRATE=true
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ALLOWED_ORIGINS=*
MEDIAMTX_ENABLED=false
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_TOKEN=
